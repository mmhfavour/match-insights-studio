# Microsoft Foundry (leave empty to run in template mode)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5-mini
AGENT_TIMEOUT_S=12

# Match replay
MATCH_SEED=21
MATCH_SCRIPT=default
REPLAY_SPEED=30
LOOP_REPLAY=1
AUTOSTART=1

# Producer desk
AUTO_APPROVE=1
AUTO_APPROVE_DELAY_S=5
